{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": { "PublicBaseUrl": "http://localhost:4200" },
  "Jwt": { "Issuer": "hatidsuki", "Audience": "hatidsuki-frontend", "AccessMinutes": 15, "RefreshDays": 30 },
  "Database": { "MigrateOnStartup": false },
  "Seed": { "Demo": false, "AllowInProduction": false },
  "RateLimits": { "PublicPerMinute": 120, "AuthPerMinute": 20 },
  "Cors": { "AllowedOrigins": [] },
  "Resend": { "FromAddress": "orders@example.com" }
}
